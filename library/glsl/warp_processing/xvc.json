{
  "name": "Warp Shader",
  "framework": "processing",
  "build": "",
  "run": "Processing.exe cli --sketch=<SKETCH> --run",
  "spout": true,
  "tags": ["warp", "effect", "frag", "shader"],
  "description": "GLSL domain warping with fbm — via Processing",
  "requires": [],
  "install_hint": "Install Processing from processing.org/download",
  "outputs": [
    { "name": "Window", "protocol": "window", "run_cmd": "Processing.exe cli --sketch=<SKETCH> --run" }
  ],
  "parameters": [
    { "name": "warp_speed", "address": "/warp/speed", "min": 0.01, "max": 0.5, "default": 0.15 },
    { "name": "fbm_octaves", "address": "/warp/octaves", "min": 1, "max": 8, "default": 6 },
    { "name": "color_shift", "address": "/warp/color", "min": 0, "max": 1, "default": 0.5 }
  ],
  "osc": { "host": "127.0.0.1", "port": 9003 }
}
