{
  "name": "Wave Mesh",
  "framework": "nannou",
  "build": "cargo build --release",
  "run": "cargo run --release",
  "spout": false,
  "tags": ["mesh", "3d", "wave"],
  "description": "Animated 3D mesh with sine wave displacement",
  "requires": ["cargo"],
  "install_hint": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh",
  "outputs": [
    { "name": "Window", "protocol": "window", "run_cmd": "cargo run --release" }
  ],
  "parameters": [
    { "name": "wave_speed", "address": "/mesh/speed", "min": 0.1, "max": 3.0, "default": 1.2 },
    { "name": "wave_amplitude", "address": "/mesh/amplitude", "min": 1, "max": 30, "default": 12 },
    { "name": "color_shift", "address": "/mesh/hue", "min": 0, "max": 1, "default": 0.05 }
  ],
  "osc": { "host": "127.0.0.1", "port": 9002 }
}
